APP_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/shop_ease_ecommerce
MONGODB_DATABASE=shop_ease_ecommerce

# Replace with a unique random value of at least 32 characters.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_ACCESS_TOKEN_TTL_MINUTES=15

# Configure all SMTP values to enable verification and recovery email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=
PUBLIC_API_BASE_URL=http://localhost:8080

ORDER_OPERATIONS_TOKEN=

BAKONG_TOKEN=
BAKONG_BASE_URL=https://api-bakong.nbc.gov.kh
BAKONG_MERCHANT_ACCOUNT_ID=
BAKONG_MERCHANT_NAME=
BAKONG_MERCHANT_CITY=
BAKONG_REQUEST_TIMEOUT_SECONDS=15
BAKONG_PAYMENT_EXPIRY_MINUTES=30
